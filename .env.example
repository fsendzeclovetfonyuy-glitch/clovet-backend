# Copy this to .env for local testing (or set as environment variables on
# your hosting provider — never commit the real .env file to GitHub).

# A shared secret only your app and this server know. Make up any long
# random string. Must match _appSecret in AiAssistService AND CallScreen
# in the Flutter app.
APP_SHARED_SECRET=change-this-to-a-long-random-string

# From your Anthropic Console (console.anthropic.com) — powers smart
# replies, summaries, translation.
ANTHROPIC_API_KEY=

# From your LiveKit Cloud project settings (cloud.livekit.io) — powers
# voice/video calls.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# Firebase service-account JSON (whole file contents on one variable).
# Only needed for call push notifications.
FIREBASE_SERVICE_ACCOUNT=

PORT=8080
